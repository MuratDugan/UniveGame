"disclaimer.os.body" = "UniveGame is built on its own open-source engine, UniveEngine, derived from MacadeKit, the open-source core of MaPC (Apache 2.0). Games run with Wine (LGPL 2.1+), DXVK (zlib), MoltenVK (Apache 2.0) and Wine Mono (MIT, LGPL, GPL). For Epic and GOG, Legendary and gogdl (GPL 3.0) run as separate programs; UniveGame neither includes nor modifies their code. Each component comes with its own license; the license texts ship inside the engines, and source code for the LGPL/GPL components is available from their publishers.";
"disclaimer.apple.title" = "Apple's D3DMetal";
"disclaimer.apple.body" = "D3DMetal is part of Apple's Game Porting Toolkit and doesn't come with UniveGame. You download it from Apple yourself, and its use is governed by Apple's license.";
"disclaimer.warranty.title" = "No warranty";
"disclaimer.warranty.body" = "UniveGame and its components are provided \"AS IS\", without warranty of any kind, express or implied, including merchantability, fitness for a particular purpose, freedom from errors, or that any game will run. Compatibility scores are estimates only.";
"disclaimer.liability.title" = "Limitation of liability";
"disclaimer.liability.body" = "To the fullest extent permitted by law, the developers of UniveGame are not liable for any direct or indirect damage arising from using or being unable to use the app, including lost data or save files, game or system problems, and account restrictions or bans.";
"disclaimer.accounts.title" = "Your game accounts and anti-cheat";
"disclaimer.accounts.body" = "Running Windows games through Wine may conflict with some games' or stores' terms of use. Anti-cheat systems may not recognize Wine and can restrict or ban your account. Taking that risk in online games is your responsibility. Keep backups of important saves.";
"disclaimer.games.title" = "Games and their licenses";
"disclaimer.games.body" = "UniveGame doesn't sell or distribute games. Only run games you legally own; each game is subject to its own license and terms of use.";
"disclaimer.trademarks.title" = "Trademarks";
